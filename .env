# Environment Configuration for NLP to SQL Query Assistant
# Note: Per repository requirements, this file is tracked and not ignored by git.

# Google Gemini API Key (leave empty for local schema-aware generator mode)
GEMINI_API_KEY=

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=

# LLM Model Name
LLM_MODEL=gemini-3.5-flash-lite

# Path to local SQLite Database
SQL_DB_PATH=data/company_database.sqlite
